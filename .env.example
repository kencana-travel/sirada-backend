# Salin menjadi .env untuk lokal (JANGAN commit .env). Di Railway, isi lewat tab Variables.

# Lokal: SQLite. Railway: referensikan Postgres -> DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./kencana.db
# WAJIB di Railway. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Email via Brevo (gratis 300 email/hari). Buat API key di Brevo -> SMTP & API -> API Keys.
# Kosongkan BREVO_API_KEY dan RESEND_API_KEY untuk mode dev: link dicetak di log server.
BREVO_API_KEY=
# Email pengirim HARUS sudah diverifikasi di Brevo (Senders, Domains & Dedicated IPs -> Senders).
MAIL_FROM=SIRADA Kencana <kencanasolo406@gmail.com>
# Opsional (lama): Resend. Dipakai hanya bila BREVO_API_KEY kosong.
RESEND_API_KEY=

# URL frontend — dipakai untuk link di email & CORS. Railway: https://<frontend>.up.railway.app
FRONTEND_URL=http://localhost:5173
# Opsional: origin tambahan untuk CORS, dipisah koma
CORS_ORIGINS=

# Akun Admin pertama (hanya dibuat saat tabel pengguna kosong). Bila kosong,
# dibuat 3 akun demo dengan password lemah.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAMA=Admin Kencana
